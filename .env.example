# Copy to .env.local. Next.js loads it automatically.
# Google Cloud OAuth client. Authorized JavaScript origin:
# http://localhost:3000
# https://foodyanyway.com
# Authorized redirect URI:
# http://localhost:3000/api/auth/callback/google
# https://foodyanyway.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the Better Auth session cookie. At least 32 characters in production.
# openssl rand -base64 32
SESSION_SECRET=
# Used when a page has no recipe. Public YouTube URLs are sent to this model.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Public site URL. On Vercel set this to https://foodyanyway.com
# APP_ORIGIN=http://localhost:3000
# Postgres connection string. On Neon, use the pooled connection string.
# DATABASE_URL=postgres://user:password@host/foody?sslmode=require
# Comma-separated emails that are admins in addition to the first account.
# ADMIN_EMAILS=
# Stitch MCP for this project. Create a key in Stitch settings. Cursor reads it from .env.
# STITCH_API_KEY=
