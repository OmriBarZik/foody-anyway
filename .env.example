# Copy to .env. Bun loads it automatically.
# Google Cloud OAuth client. Authorized redirect URI:
# http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string. Required when NODE_ENV=production.
SESSION_SECRET=
# Used when a page has no recipe. Public YouTube URLs are sent to this model.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# APP_ORIGIN=http://localhost:3000
# PORT=3000
# FOODY_DB=data/foody.db
# Comma-separated emails that are admins in addition to the first account.
# ADMIN_EMAILS=
